+int process_ui_data(char *buffer, size_t size, void *user_data)
+{
+    try {
+        const auto message = json::parse(buffer, buffer + size);
+        if (message.value("type", "") != "wake") return 0;
+        extern std::atomic<bool> g_client_ready;
+        if (!g_client_ready.load()) {
+            send_device_state();
+            return 0;
+        }
+        std::cout << "Manual wake requested" << std::endl;
+        if (mqtt_enabled()) start_turn_timeout(20);
+        if (!g_websocket_start) {
+            set_device_state(kDeviceStateConnecting);
+            send_device_state();
+            connect_to_xiaozhi_server();
+        } else {
+            g_accept_server_audio = false;
+            g_waiting_for_interruption_speech = true;
+            if (g_server_speaking.exchange(false)) {
+                g_ignore_interrupted_stop = true;
+                set_wake_playback(false);
+            }
+            abort_cur_session();
+            std::cout << "Wake interruption requested; listening for new speech" << std::endl;
+            send_start_listening_req(kListeningModeAutoStop);
+            g_audio_upload_enable = 1;
+            set_device_state(kDeviceStateListening);
+            send_device_state();
+        }
+    } catch (const std::exception &error) {
+        std::cerr << "Invalid UI message: " << error.what() << std::endl;
+        return -1;
+    }
+    return 0;
+}
 
